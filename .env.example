# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; also the X-Admin-Key for /api/admin/*

# OpenAI — analysis, synthesis, embeddings, Whisper
OPENAI_API_KEY=

# Gather
APIFY_TOKEN=                        # TikTok + Instagram + Reddit scraping actors, YouTube transcript actor
YOUTUBE_API_KEY=                    # YouTube Data API v3 (free tier)
TRANSCRIPTS_ENABLED=1               # master switch for the video-transcript layer
INCREMENTAL_PASS_A=0                # 1 = Pass A re-reads only changed videos (selection only; see lib/config.ts)
THEME_REGISTRY=0                    # 1 = persistent theme identity (registry + observations)

# Email (Resend) — invites, weekly reports. Unset = log-and-skip stub.
RESEND_API_KEY=
EMAIL_FROM="Verbatim <invites@verbatimintel.com>"
ALERT_EMAIL=                        # operator address for run-failure alerts; unset = no alerts

# App
NEXT_PUBLIC_APP_URL=https://app.verbatimintel.com

# Stripe (built but OFF)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional Apify actor overrides (hardcoded defaults exist in lib/config.ts)
# APIFY_TT_VIDEO_ACTOR=
# APIFY_TT_COMMENT_ACTOR=
# APIFY_IG_VIDEO_ACTOR=
# APIFY_IG_COMMENT_ACTOR=
# APIFY_IG_POST_ACTOR=
# APIFY_REDDIT_ACTOR=
# APIFY_YT_TRANSCRIPT_ACTOR=          # YouTube captions (Wave 4); default scrape-creators~best-youtube-transcripts-scraper

# Sign-up gate (T0-3). /signup requires this code while the motion is sales-led;
# unset means sign-up is closed (fails safe). The marketing lead form is the front door.
SIGNUP_INVITE_CODE=

# Ops bearer for /api/admin/* (T0-11). Separate from the service-role key so the
# ops credential can be rotated without re-keying every server-side Supabase call.
ADMIN_API_KEY=

# Hard ceiling on model spend within one pipeline run (Tier 1). Default 15.
# Real runs cost $2.18-$2.70; this stops a runaway, it is not a budget to plan
# against. Exceeding it fails the run loudly rather than draining the account.
RUN_MODEL_BUDGET_USD=

# Data retention sweep (T0-9). Deploys DORMANT: set to 1 only when you are
# ready to watch the first pass. It is the only destructive job in the product.
RETENTION_ENABLED=

# Demo tenant seeding (T0-9). scripts/seed-demo.ts refuses to run without this;
# the old hardcoded '123456' guarded a verbatim clone of a real client's corpus.
DEMO_PASSWORD=

# Marketing-site origin, for in-app links to /privacy and /terms (T0-9).
# Defaults to https://verbatimintel.com in production.
NEXT_PUBLIC_SITE_URL=

# Consumer profile (Pass E, 2026-08-19). OFF unless set. Gates the pass and its
# Inngest step; the consumer_profiles table is inert without it. A profile can
# still be produced for a completed run offline: scripts/consumer-profile.ts.
CONSUMER_PROFILE=

# Reports & Exports (2026-08-29). Signs the short-lived token that lets the
# export renderer's headless Chrome fetch /render/<snapshot> without a session.
# Falls back to the service-role key when unset; set it so they rotate apart.
RENDER_TOKEN_SECRET=
# Local development only: a Chrome/Chromium binary for rendering. On Vercel the
# bundled @sparticuz/chromium is used and this is ignored.
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Origin the renderer's Chrome fetches /render from. Unset = this deployment
# (VERCEL_URL on a preview, NEXT_PUBLIC_APP_URL in production, localhost in dev).
# RENDER_BASE_URL=

# Feature flags, OFF unless set: the Verbatim Agent page (AGENT_ENABLED=1) and
# subreddit discovery in the gather phase (REDDIT_DISCOVERY_ENABLED=1).
AGENT_ENABLED=
REDDIT_DISCOVERY_ENABLED=

# Dev-only screenshot/smoke scripts (scripts/shot.ts, export-smoke.ts, …) sign
# in as this account; default demo@verbatimintel.com + DEMO_PASSWORD.
# SHOT_EMAIL=
# SHOT_PASSWORD=
