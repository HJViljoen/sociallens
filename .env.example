# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; also the X-Admin-Key for /api/admin/*

# OpenAI — analysis, synthesis, embeddings, Whisper
OPENAI_API_KEY=

# Gather
APIFY_TOKEN=                        # TikTok + Instagram + Reddit scraping actors, YouTube transcript actor
YOUTUBE_API_KEY=                    # YouTube Data API v3 (free tier)
TRANSCRIPTS_ENABLED=1               # master switch for the video-transcript layer

# Email (Resend) — invites, weekly reports. Unset = log-and-skip stub.
RESEND_API_KEY=
EMAIL_FROM="Verbatim <invites@verbatimintel.com>"
ALERT_EMAIL=                        # operator address for run-failure alerts; unset = no alerts

# App
NEXT_PUBLIC_APP_URL=https://app.verbatimintel.com

# Stripe (built but OFF)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional Apify actor overrides (hardcoded defaults exist in lib/config.ts)
# APIFY_TT_VIDEO_ACTOR=
# APIFY_TT_COMMENT_ACTOR=
# APIFY_IG_VIDEO_ACTOR=
# APIFY_IG_COMMENT_ACTOR=
# APIFY_IG_POST_ACTOR=
# APIFY_REDDIT_ACTOR=
# APIFY_YT_TRANSCRIPT_ACTOR=          # YouTube captions (Wave 4); default scrape-creators~best-youtube-transcripts-scraper
